# ─── Brox Padel · API (NestJS) ───
# "npm run setup" copia este archivo a .env y genera los secretos solo.

# Base de datos (docker-compose la levanta en el puerto 5433)
DATABASE_URL=postgres://brox:brox@localhost:5433/broxpadel
API_PORT=4000
# 127.0.0.1 = solo accesible desde el mismo servidor (Nginx). 0.0.0.0 para exponerla en la red
API_HOST=127.0.0.1

# Seguridad: cadenas largas y al azar (el setup las genera)
JWT_SECRET=cambiar
# Mismo valor que en apps/web/.env.local
REVALIDATE_SECRET=cambiar
# En producción con HTTPS: true
COOKIE_SECURE=false

# URL pública de la tienda (links de mails y de Mercado Pago) y URL interna de Next
PUBLIC_URL=http://localhost:3000
WEB_INTERNAL_URL=http://127.0.0.1:3000

# ─── Mercado Pago (Checkout Pro) ───
# Credenciales de PRUEBA: mercadopago.com.ar/developers → Tus integraciones → tu app → Credenciales de prueba
# (empiezan con TEST-). Sin token, el botón de Mercado Pago no aparece en el checkout.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Webhooks → "Clave secreta" (para validar la firma x-signature)
MP_WEBHOOK_SECRET=
# URL pública a la que MP avisa los pagos. En local usá un túnel (ngrok/cloudflared) o dejala vacía:
# igual el pedido se actualiza cuando el cliente vuelve a la tienda.
MP_NOTIFICATION_URL=
# Solo para pruebas automáticas (servidor simulado). No tocar.
MP_API_BASE=https://api.mercadopago.com
# Horas para cancelar pedidos de MP sin pagar (devuelve el stock)
PENDING_ORDER_TTL_HOURS=48

# ─── Mails de confirmación ───
# Sin SMTP, los mails se guardan como .eml en apps/api/storage/mail-outbox (para revisarlos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brox Padel <hola@broxpadel.com>"
# A quién avisar de cada pedido nuevo
MAIL_NOTIFY=

# ─── Carga inicial (npm run db:seed) ───
SEED_ADMIN_EMAIL=admin@broxpadel.com
SEED_ADMIN_PASSWORD=BroxPadel2026!
SEED_EDITOR_PASSWORD=BroxEditor2026!
# WhatsApp de la tienda: código de país + área + número, sin + ni espacios
SEED_WHATSAPP=5492255409164

# Opcionales: carpeta de archivos subidos y binarios propios de ffmpeg
# STORAGE_DIR=
# FFMPEG_PATH=
# FFPROBE_PATH=
