# ─── Brox Padel · web (Next.js) ───
# Dónde escucha la API (el navegador usa /api y /media del mismo dominio)
API_INTERNAL_URL=http://127.0.0.1:4000
# Dominio público (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mismo valor que REVALIDATE_SECRET de apps/api/.env
REVALIDATE_SECRET=cambiar
